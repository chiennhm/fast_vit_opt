# Number of batches between CUDA cache clears during evaluation.
# Keeps VRAM fragmentation in check without excessive overhead.
_EVAL_CACHE_CLEAR_INTERVAL = 50


def save_predictions_to_json(predictions, output_path, dataset_name="voc", arch="fastvit"):
    """Save predictions to JSON file for offline mAP computation.

    Args:
        predictions: list of dicts with keys 'boxes', 'labels', 'scores'
        output_path: path to output JSON file
        dataset_name: dataset name for metadata
        arch: architecture type ('fastvit' or 'maskrcnn'). For maskrcnn,
              filters out background predictions (label 0).
    """
    results = []
    for img_idx, pred in enumerate(predictions):
        pred_boxes = pred["boxes"]
        pred_scores = pred["scores"]
        pred_labels = pred["labels"]

        # Handle both numpy and torch tensors
        if isinstance(pred_boxes, np.ndarray):
            pass  # already numpy
        elif hasattr(pred_boxes, 'cpu'):
            pred_boxes = pred_boxes.cpu().numpy()
        else:
            pred_boxes = np.array(pred_boxes)

        if isinstance(pred_scores, np.ndarray):
            pass
        elif hasattr(pred_scores, 'cpu'):
            pred_scores = pred_scores.cpu().numpy()
        else:
            pred_scores = np.array(pred_scores)

        if isinstance(pred_labels, np.ndarray):
            pass
        elif hasattr(pred_labels, 'cpu'):
            pred_labels = pred_labels.cpu().numpy()
        else:
            pred_labels = np.array(pred_labels)

        for i in range(len(pred_boxes)):
            label = int(pred_labels[i])

            # For MaskRCNN, filter out background predictions (label 0)
            if arch == "maskrcnn" and label == 0:
                continue

            x1, y1, x2, y2 = pred_boxes[i]
            w = float(x2 - x1)
            h = float(y2 - y1)
            results.append({
                "image_id": img_idx,
                "category_id": label,
                "bbox": [float(x1), float(y1), w, h],  # COCO format: [x, y, w, h]
                "score": float(pred_scores[i]),
            })

    with open(output_path, "w") as f:
        json.dump(results, f, indent=2)


def save_ground_truths_to_json(ground_truths, output_path, dataset_name="voc", num_classes=None, class_names=None):
    """Save ground truths to JSON file for offline mAP computation.

    Args:
        ground_truths: list of dicts with keys 'boxes', 'labels', and optional keys
        output_path: path to output JSON file
        dataset_name: dataset name for metadata
        num_classes: number of classes (inferred if None)
        class_names: list of class names (optional, defaults to class_N format)
    """
    images = []
    annotations = []
    ann_id = 1

    # Infer num_classes from data if not provided
    if num_classes is None:
        max_label = 0
        for gt in ground_truths:
            labels = gt.get("labels", [])
            if len(labels) > 0:
                if isinstance(labels, np.ndarray):
                    max_label = max(max_label, int(labels.max()))
                elif hasattr(labels, 'cpu'):
                    max_label = max(max_label, int(labels.max().item()))
                else:
                    max_label = max(max_label, int(max(labels)))
        num_classes = max_label

    for img_idx, gt in enumerate(ground_truths):
        # Register each image
        images.append({
            "id": img_idx,
            "width": 0,  # Not used for bbox evaluation
            "height": 0,
        })

        gt_boxes = gt["boxes"]
        gt_labels = gt["labels"]

        # Handle both numpy and torch tensors
        if isinstance(gt_boxes, np.ndarray):
            pass
        elif hasattr(gt_boxes, 'cpu'):
            gt_boxes = gt_boxes.cpu().numpy()
        else:
            gt_boxes = np.array(gt_boxes)

        if isinstance(gt_labels, np.ndarray):
            pass
        elif hasattr(gt_labels, 'cpu'):
            gt_labels = gt_labels.cpu().numpy()
        else:
            gt_labels = np.array(gt_labels)

        # Optional: difficults / iscrowd
        difficults = gt.get("difficults", None)
        if difficults is not None and isinstance(difficults, np.ndarray):
            pass
        elif hasattr(difficults, 'cpu') if difficults else False:
            difficults = difficults.cpu().numpy()
        elif difficults is not None:
            difficults = np.array(difficults)

        iscrowd = gt.get("iscrowd", None)
        if iscrowd is not None and isinstance(iscrowd, np.ndarray):
            pass
        elif hasattr(iscrowd, 'cpu') if iscrowd else False:
            iscrowd = iscrowd.cpu().numpy()
        elif iscrowd is not None:
            iscrowd = np.array(iscrowd)

        for i in range(len(gt_boxes)):
            x1, y1, x2, y2 = gt_boxes[i]
            w = float(x2 - x1)
            h = float(y2 - y1)

            # iscrowd: use explicit iscrowd, else treat difficults as crowd
            if iscrowd is not None:
                is_crowd = int(iscrowd[i])
            elif difficults is not None:
                is_crowd = int(difficults[i])
            else:
                is_crowd = 0

            annotations.append({
                "id": ann_id,
                "image_id": img_idx,
                "category_id": int(gt_labels[i]),
                "bbox": [float(x1), float(y1), w, h],  # COCO format: [x, y, w, h]
                "area": w * h,
                "iscrowd": is_crowd,
            })
            ann_id += 1

    # Categories
    categories = []
    for cls_id in range(1, num_classes + 1):
        if class_names and cls_id - 1 < len(class_names):
            name = class_names[cls_id - 1]
        else:
            name = f"class_{cls_id}"
        categories.append({"id": cls_id, "name": name})

    coco_gt = {
        "images": images,
        "annotations": annotations,
        "categories": categories,
    }

    with open(output_path, "w") as f:
        json.dump(coco_gt, f, indent=2)


@torch.inference_mode()
def evaluate(model, dataloader, device, args, save_vis=False, output_dir=None):
    """Evaluate model on validation set.

    Memory-optimised evaluation loop:
    - Converts tensors to numpy immediately to release torch/CUDA memory.
    - Periodically calls ``torch.cuda.empty_cache()`` + ``gc.collect()``.
    - Respects ``args.max_eval_samples`` to cap the number of images.
    - Optionally saves predictions to JSON to avoid OOM during mAP computation.
    """
    model.eval()

    all_predictions = []
    all_ground_truths = []
    save_json = getattr(args, "save_json", False)
    score_thresh = getattr(args, "score_thresh", 0.05)
    nms_thresh = getattr(args, "nms_thresh", 0.5)
    max_detections = getattr(args, "max_detections", 100)

    use_amp = args.amp and device.type == "cuda"
    max_eval_samples = getattr(args, "max_eval_samples", None)
    total_batches = len(dataloader)
    total_images_seen = 0

    if save_json:
        json_dir = getattr(args, "json_output_dir", None) or os.path.join(output_dir, "json_results")
        os.makedirs(json_dir, exist_ok=True)
        dataset_name = args.dataset.upper()
        pred_json = os.path.join(json_dir, f"predictions_{dataset_name}.json")
        gt_json = os.path.join(json_dir, f"ground_truths_{dataset_name}.json")

        f_pred = open(pred_json, "w")
        f_pred.write("[\n")
        first_pred = True

        gt_images = []
        gt_annotations = []
        gt_ann_id = 1
        global_img_idx = 0
        arch_type = getattr(args, "arch", "fastvit")

    logger.info(f"Running evaluation (score_thresh={score_thresh}, nms_thresh={nms_thresh}, max_detections={max_detections})...")
    if max_eval_samples is not None:
        logger.info(f"  Max eval samples capped at {max_eval_samples}")
    start_time = time.time()

    pbar = tqdm(enumerate(dataloader), total=total_batches, desc="Evaluating", leave=False)
    for batch_idx, (images, targets) in pbar:
        # Early exit if we have collected enough samples
        if max_eval_samples is not None and total_images_seen >= max_eval_samples:
            break

        images = images.to(device, non_blocking=True)

        # Get predictions (use AMP for faster inference)
        if use_amp:
            with autocast('cuda'):
                predictions = model.predict(
                    images, score_thresh=score_thresh, nms_thresh=nms_thresh, max_detections=max_detections
                )
        else:
            predictions = model.predict(
                images, score_thresh=score_thresh, nms_thresh=nms_thresh, max_detections=max_detections
            )

        if save_json:
            batch_start_img_idx = global_img_idx
            # Stream predictions directly to JSON file batch by batch
            for p_idx, pred in enumerate(predictions):
                img_id_pred = batch_start_img_idx + p_idx
                pred_boxes = pred["boxes"].detach().cpu().numpy() if isinstance(pred["boxes"], torch.Tensor) else np.array(pred["boxes"])
                pred_scores = pred["scores"].detach().cpu().numpy() if isinstance(pred["scores"], torch.Tensor) else np.array(pred["scores"])
                pred_labels = pred["labels"].detach().cpu().numpy() if isinstance(pred["labels"], torch.Tensor) else np.array(pred["labels"])

                for i in range(len(pred_boxes)):
                    label = int(pred_labels[i])
                    if arch_type == "maskrcnn" and label == 0:
                        continue
                    x1, y1, x2, y2 = pred_boxes[i]
                    w = float(x2 - x1)
                    h = float(y2 - y1)
                    item = {
                        "image_id": img_id_pred,
                        "category_id": label,
                        "bbox": [float(x1), float(y1), w, h],
                        "score": float(pred_scores[i]),
                    }
                    if not first_pred:
                        f_pred.write(",\n")
                    f_pred.write(json.dumps(item))
                    first_pred = False

            # Build ground truths for this batch
            for gt_idx, gt in enumerate(targets):
                img_id_gt = batch_start_img_idx + gt_idx
                gt_images.append({"id": img_id_gt, "width": 0, "height": 0})
                gt_boxes = gt["boxes"].detach().cpu().numpy() if isinstance(gt["boxes"], torch.Tensor) else np.array(gt["boxes"])
                gt_labels = gt["labels"].detach().cpu().numpy() if isinstance(gt["labels"], torch.Tensor) else np.array(gt["labels"])
                difficults = gt.get("difficults", None)
                if difficults is not None and isinstance(difficults, torch.Tensor):
                    difficults = difficults.cpu().numpy()
                iscrowd = gt.get("iscrowd", None)
                if iscrowd is not None and isinstance(iscrowd, torch.Tensor):
                    iscrowd = iscrowd.cpu().numpy()

                for i in range(len(gt_boxes)):
                    x1, y1, x2, y2 = gt_boxes[i]
                    w = float(x2 - x1)
                    h = float(y2 - y1)
                    if iscrowd is not None:
                        is_c = int(iscrowd[i])
                    elif difficults is not None:
                        is_c = int(difficults[i])
                    else:
                        is_c = 0
                    gt_annotations.append({
                        "id": gt_ann_id,
                        "image_id": img_id_gt,
                        "category_id": int(gt_labels[i]),
                        "bbox": [float(x1), float(y1), w, h],
                        "area": w * h,
                        "iscrowd": is_c,
                    })
                    gt_ann_id += 1

            global_img_idx += len(images)
        else:
            # In-memory storage for direct mAP evaluation
            for pred in predictions:
                clean_pred = {}
                for k, v in pred.items():
                    if isinstance(v, torch.Tensor):
                        clean_pred[k] = v.detach().cpu().numpy()
                    else:
                        clean_pred[k] = v
                all_predictions.append(clean_pred)

            for gt in targets:
                clean_gt = {}
                for k, v in gt.items():
                    if k == "masks":
                        continue
                    if isinstance(v, torch.Tensor):
                        clean_gt[k] = v.detach().cpu().numpy()
                    else:
                        clean_gt[k] = v
                all_ground_truths.append(clean_gt)

        total_images_seen += images.shape[0]

        # Save visualizations for first few batches
        if save_vis and output_dir and batch_idx < 5:
            vis_dir = os.path.join(output_dir, "visualizations")
            if args.dataset == "coco":
                class_names = COCO_CLASSES
            elif args.dataset == "bdd100k":
                class_names = BDD100K_CLASSES
            else:
                class_names = VOC_CLASSES
            save_detection_results(
                images,
                predictions,
                vis_dir,
                class_names=class_names,
                score_thresh=0.3,
            )

        # Release GPU references from this batch and clear cache periodically
        del images, targets, predictions
        if device.type == "cuda" and (batch_idx + 1) % _EVAL_CACHE_CLEAR_INTERVAL == 0:
            torch.cuda.empty_cache()
            gc.collect()

        if not HAS_TQDM and (batch_idx + 1) % args.log_interval == 0:
            elapsed_so_far = time.time() - start_time
            speed = total_images_seen / max(elapsed_so_far, 1e-6)
            remaining = (total_batches - batch_idx - 1) * (elapsed_so_far / (batch_idx + 1))
            logger.info(
                f"  Eval batch {batch_idx+1}/{total_batches}  "
                f"({total_images_seen} imgs, {speed:.1f} img/s, ETA {remaining:.0f}s)"
            )

    # Final cache clear before mAP computation
    if device.type == "cuda":
        torch.cuda.empty_cache()
    gc.collect()

    elapsed = time.time() - start_time
    logger.info(f"Evaluation inference completed in {elapsed:.1f}s ({total_images_seen} images)")

    # Save to JSON if requested (skip mAP computation to avoid OOM)
    if save_json:
        f_pred.write("\n]\n")
        f_pred.close()
        logger.info(f"Predictions successfully streamed to {pred_json}")

        if args.dataset == "coco":
            num_classes, class_names = 80, COCO_CLASSES
        elif args.dataset == "bdd100k":
            num_classes, class_names = 10, BDD100K_CLASSES
        else:
            num_classes, class_names = 20, VOC_CLASSES

        categories = []
        for cls_id in range(1, num_classes + 1):
            name = class_names[cls_id - 1] if class_names and cls_id - 1 < len(class_names) else f"class_{cls_id}"
            categories.append({"id": cls_id, "name": name})

        coco_gt = {
            "images": gt_images,
            "annotations": gt_annotations,
            "categories": categories,
        }
        with open(gt_json, "w") as f:
            json.dump(coco_gt, f, indent=2)
        logger.info(f"Ground truths saved to {gt_json}")

        meta = {
            "dataset": args.dataset,
            "arch": args.arch,
            "num_images": total_images_seen,
            "model": args.model,
            "timestamp": datetime.now().isoformat(),
        }
        with open(os.path.join(json_dir, "metadata.json"), "w") as f:
            json.dump(meta, f, indent=2)
        logger.info(f"Metadata saved to {os.path.join(json_dir, 'metadata.json')}")
        logger.info("Skipping mAP computation (use compute_map.py to compute mAP from JSON files)")

        return {
            "mAP": 0.0,
            "ap_per_class": {},
            "json_saved": True,
            "pred_json": pred_json,
            "gt_json": gt_json,
        }

    # Compute mAP
    if args.dataset == "coco":
        iou_threshold = np.linspace(0.5, 0.95, 10).tolist()
    elif args.dataset == "bdd100k":
        iou_threshold = np.linspace(0.5, 0.95, 10).tolist()
    else:  # voc
        iou_threshold = 0.5

    results = evaluate_coco(
        all_predictions,
        all_ground_truths,
        num_classes=num_classes,
        iou_threshold=iou_threshold,
        class_names=class_names,
    )

    # Save evaluation metric results to JSON
    eval_json_path = os.path.join(output_dir if output_dir else "./", "eval_results.json")
    try:
        def sanitize_for_json(obj):
            if isinstance(obj, dict):
                return {k: sanitize_for_json(v) for k, v in obj.items()}
            elif isinstance(obj, list):
                return [sanitize_for_json(v) for v in obj]
            elif isinstance(obj, (np.integer, np.floating)):
                return obj.item()
            elif isinstance(obj, np.ndarray):
                return obj.tolist()
            return obj

        with open(eval_json_path, "w") as f:
            json.dump(sanitize_for_json(results), f, indent=2)
        logger.info(f"Evaluation metrics successfully saved to {eval_json_path}")
    except Exception as e:
        logger.warning(f"Could not save eval metrics to JSON: {e}")

    # Free the large prediction/gt lists after mAP is computed
    del all_predictions, all_ground_truths
    gc.collect()

    return results


# ============================================================================
